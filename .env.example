# Dirección del Backend. No incluir contraseñas ni claves privadas aquí:
# las variables EXPO_PUBLIC_ son visibles desde el código del frontend.
EXPO_PUBLIC_API_URL=

# Datos simulados (src/services/mock) mientras no existan los contratos de la API.
# Cambiar a false al integrar el Backend.
EXPO_PUBLIC_USE_MOCKS=true
